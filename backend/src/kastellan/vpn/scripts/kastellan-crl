#!/bin/sh
# kastellan-crl: the only thing Kastellan's key may run on the OpenVPN server (OpenWrt): take a
# new CRL on stdin and put it in place. OpenVPN reads the CRL at every connection. Also
# add-key / keep-key, for rotating Kastellan's VPN key (see below).
#
# Install (on the OpenVPN server):
#   install -m 755 kastellan-crl /usr/bin/kastellan-crl
#   In /etc/dropbear/authorized_keys (OpenWrt), the hub's key, bound to this script:
#     command="/usr/bin/kastellan-crl /etc/kastellan-crl.conf",no-port-forwarding,no-agent-forwarding,no-pty ssh-ed25519 AAAA... kastellan-vpn
#   and in the OpenVPN server config: crl-verify /etc/openvpn/crl.pem
#   (CRL can be overridden in /etc/kastellan-crl.conf)
set -eu
umask 022
CRL=/etc/openvpn/crl.pem
CA=/etc/openvpn/ca.crt
AUTHORIZED_KEYS=  # where its key lines are, if not the usual place (tests)
# The config is the argument fixed in authorized_keys, never the environment.
CONF=${1:-/etc/kastellan-crl.conf}
[ -r "$CONF" ] && . "$CONF"

fail() { echo "kastellan-crl: $*" >&2; exit 2; }
# Rotating Kastellan's VPN key: `add-key OLD NEW` (run with OLD), then `keep-key NEW` (run with
# NEW). Only lines bound to this script (command="<this script>" with or without arguments)
# change. add-key copies the options of OLD's line exactly (its command=, from=, limits) with NEW
# as the key, so the new key may do what the old one may and nothing more; keep-key removes every
# other key line of this script (also ones added by whoever else held a key: a leaked key ends
# here) and says how many. Keys are one ed25519 key each (the base64 part only: no options, no
# other type). The new file is checked before it replaces the old one (BusyBox-safe).
keys_file() {
  if [ -n "${AUTHORIZED_KEYS:-}" ]; then echo "$AUTHORIZED_KEYS"
  elif [ "$(id -u)" = 0 ] && [ -f /etc/openwrt_release ] && ! pidof sshd >/dev/null 2>&1; then echo /etc/dropbear/authorized_keys
  else echo "$(awk -F: -v u="$(id -un)" '$1 == u { print $6 }' /etc/passwd)/.ssh/authorized_keys"
  fi
}
ed25519() {
  case $1 in AAAAC3NzaC1lZDI1NTE5AAAAI*) ;; *) fail "not an ed25519 key" ;; esac
  [ ${#1} -eq 68 ] && [ -z "$(printf '%s' "$1" | tr -d 'A-Za-z0-9+/')" ] || fail "not an ed25519 key"
}
rekey() {
  op=$1
  ed25519 "$2"
  [ "$op" = keep ] || ed25519 "$3"
  f=$(keys_file)
  [ -f "$f" ] || fail "no $f"
  tmp="$f.kastellan-new"
  rm -f "$tmp"
  counts=$(awk -v op="$op" -v a="$2" -v b="${3:-}" -v script="$0" -v out="$tmp" '
    # A line: its options (OPT), key type (TYPE) and key (KEY), by field; quoted options may hold
    # spaces; tabs separate as spaces do.
    function parse(s,   i, c, q, w) {
      sub(/\r$/, "", s); OPT = ""; TYPE = ""; KEY = ""
      sub(/^[ \t]+/, "", s)
      if (s == "" || substr(s, 1, 1) == "#") return
      if (s !~ /^(ssh-|ecdsa-|sk-)/) {
        q = 0
        for (i = 1; i <= length(s); i++) {
          c = substr(s, i, 1)
          if (c == "\"") q = !q
          else if (!q && (c == " " || c == "\t")) break
        }
        OPT = substr(s, 1, i - 1); s = substr(s, i)
        sub(/^[ \t]+/, "", s)
      }
      split(s, w, /[ \t]+/); TYPE = w[1]; KEY = w[2]
    }
    function bound(o,   p, after) {
      p = index(o, "command=\"" script)
      if (!p || (p > 1 && substr(o, p - 1, 1) != ",")) return 0
      after = substr(o, p + length("command=\"" script), 1)
      return after == "\"" || after == " "
    }
    {
      line[NR] = $0; parse($0); opt[NR] = OPT
      mine[NR] = OPT != "" && bound(OPT); k[NR] = TYPE == "ssh-ed25519" ? KEY : ""
    }
    END {
      for (i = 1; i <= NR; i++) if (mine[i]) { if (k[i] == a) src = i; if (k[i] == b) has = 1 }
      if (!src) { print "no line of this script with that key" > "/dev/stderr"; exit 3 }
      n = 0; removed = 0
      for (i = 1; i <= NR; i++) {
        if (op == "keep" && mine[i] && k[i] != a) { removed++; continue }
        print line[i] > out; n++
      }
      if (op == "add" && !has) { print opt[src] " ssh-ed25519 " b " kastellan-vpn" > out; n++ }
      close(out)
      print n " " removed
    }' "$f") || { rm -f "$tmp"; fail "$f not changed"; }
  # Every line written, each ended: else (a full disk) the file in place stays as it is.
  lines=$(wc -l < "$tmp" 2>/dev/null | tr -d ' ') || lines=
  if [ ! -s "$tmp" ] || [ "$lines" != "${counts%% *}" ]; then
    rm -f "$tmp"; fail "$f not changed (the new file came out short)"
  fi
  chmod 600 "$tmp" || { rm -f "$tmp"; fail "$f not changed (chmod)"; }
  mv "$tmp" "$f" || { rm -f "$tmp"; fail "$f not changed (mv)"; }
  if [ "$op" = keep ]; then echo "kept $2; removed ${counts#* } other key line(s)"; else echo "add-key done"; fi
}
set -f
# shellcheck disable=SC2086 # split into words on purpose (globbing is off)
set -- ${SSH_ORIGINAL_COMMAND:-}
set +f
case "${1:-}:$#" in
  add-key:3) rekey add "$2" "$3"; exit 0 ;;
  keep-key:2) rekey keep "$2"; exit 0 ;;
  install:1) ;;
  *) fail "only 'install' (and add-key / keep-key)" ;;
esac
tmp="$CRL.new"
head -c 1048576 > "$tmp"
refuse() { rm -f "$tmp"; echo "kastellan-crl: $*" >&2; exit 2; }
grep -q "^-----BEGIN X509 CRL-----" "$tmp" && grep -q "^-----END X509 CRL-----" "$tmp" || refuse "not a CRL"
if command -v openssl >/dev/null 2>&1; then
  # Signed by our CA (a CRL from elsewhere would leave no revocation in force with some builds)...
  verified=$(LC_ALL=C openssl crl -in "$tmp" -noout -CAfile "$CA" 2>&1) || refuse "not signed by $CA"
  # Some OpenSSL/LibreSSL versions exit successfully even for "verify failure".
  [ "$verified" = "verify OK" ] || refuse "not signed by $CA"
  # ...and not older than the one in place (an old CRL would un-revoke clients).
  crl_time() {
    LC_ALL=C openssl crl -in "$1" -noout -lastupdate 2>/dev/null | awk -F= '
      /^lastUpdate=/ {
        split($2, d, / +/); split("Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec", months, " ")
        for (m = 1; m <= 12; m++) if (months[m] == d[1] && d[5] == "GMT") {
          gsub(/:/, "", d[3]); printf "%04d%02d%02d%s\n", d[4], m, d[2], d[3]; exit
        }
      }'
  }
  new_time=$(crl_time "$tmp")
  [ -n "$new_time" ] || refuse "cannot read the CRL's issue time"
  if [ -r "$CRL" ]; then
    old_time=$(crl_time "$CRL")
    [ -n "$old_time" ] || refuse "cannot read the installed CRL's issue time"
    if ! awk -v old="$old_time" -v new="$new_time" 'BEGIN { exit ("x" new < "x" old) }'; then
      refuse "older than the CRL in place"
    fi
  fi
  new=$(openssl crl -in "$tmp" -noout -crlnumber 2>/dev/null | sed 's/.*=//; s/^0x//')
  old=""
  if [ -r "$CRL" ]; then old=$(openssl crl -in "$CRL" -noout -crlnumber 2>/dev/null | sed 's/.*=//; s/^0x//' || true); fi
  # Also compare numbers when present (easy-rsa 3.2 writes none by default).
  case "$new" in *[!0-9A-Fa-f]* | "") new="" ;; esac
  case "$old" in *[!0-9A-Fa-f]* | "") old="" ;; esac
  if [ -n "$old" ] && [ -n "$new" ]; then
    # CRL numbers can exceed shell integers: compare normalized hex strings, not arithmetic.
    if ! awk -v old="$old" -v new="$new" 'BEGIN {
      old = tolower(old); new = tolower(new); sub(/^0+/, "", old); sub(/^0+/, "", new)
      exit (length(new) < length(old) || (length(new) == length(old) && "x" new < "x" old))
    }'; then refuse "older than the CRL in place"; fi
  fi
else
  refuse "openssl is required to verify the CRL (OpenWrt: opkg install openssl-util)"
fi
mv "$tmp" "$CRL"
echo "installed"
