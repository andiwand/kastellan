#!/usr/bin/env bash
# kastellan-pki: the only thing Kastellan's key may run on the host with the OpenVPN PKI.
#
# Install (on the PKI host, e.g. SV1; the hub's setup page shows the exact commands):
#   sudo install -m 755 kastellan-pki /usr/local/bin/kastellan-pki
#   sudo useradd --system --create-home kastellan-pki   # a user that owns (or may use) the PKI
#   In ~kastellan-pki/.ssh/authorized_keys, Kastellan's VPN key, bound to this script:
#     restrict,command="/usr/local/bin/kastellan-pki /etc/kastellan-pki-<vpn>.conf" ssh-ed25519 AAAA... kastellan-vpn
#   /etc/kastellan-pki-<vpn>.conf (one per VPN; /etc/kastellan-pki.conf for the VPN "openvpn"):
#     EASYRSA_DIR=/etc/openvpn/easy-rsa      # where ./easyrsa and pki/ are
#     TEMPLATE=/etc/kastellan-pki/client.ovpn  # client config with {{ca}} {{cert}} {{key}} {{tls}}
#     TLS_KEY=/etc/openvpn/server/tc.key        # tls-crypt/tls-auth key to inline, if used
#     RESERVED="server vpn-server"              # certificate names that are never clients
#
# Only client certificates are ever touched: their extended key usage must say TLS client
# authentication and not server authentication, and their name must not be reserved. The
# server's certificate and the CA can't be exported, revoked or re-issued through this script.
#
# Commands (in SSH_ORIGINAL_COMMAND, nothing else is run):
#   list                 one line per certificate: status, expiry, serial, name (tab-separated)
#   issue NAME DAYS      a new client certificate and key (no passphrase), valid DAYS days
#   revoke NAME          revoke it and renew the CRL (again, if it was revoked already)
#   renew-crl            renew the CRL (it expires; the hub does this daily)
#   crl                  the current CRL (PEM)
#   version              this script's digest (the hub tells when it is older than its own)
#   export NAME          the client's .ovpn, with its certificate and key inline
#   add-key OLD NEW      rotating the VPN key: NEW (ed25519) may do what OLD may here
#   keep-key KEY         ...then only KEY stays bound to this script (every other line goes)
set -euo pipefail
umask 077

EASYRSA_DIR=/etc/openvpn/easy-rsa
TEMPLATE=/etc/kastellan-pki/client.ovpn
TLS_KEY=
RESERVED="server"
AUTHORIZED_KEYS=  # where its key lines are, if not the usual place (tests)
# The config is the argument fixed in authorized_keys (never the environment: an sshd with
# AcceptEnv * would let the caller choose it).
CONF=${1:-/etc/kastellan-pki.conf}
[ -r "$CONF" ] && . "$CONF"

read -r -a args <<< "${SSH_ORIGINAL_COMMAND:-}"
command=${args[0]:-}
# Which version of this script is installed (the hub compares it with its own).
if [ "$command" = version ]; then sha256sum "$0" | cut -c1-16; exit 0; fi
name=${args[1]:-}
days=${args[2]:-}

fail() { echo "kastellan-pki: $*" >&2; exit 2; }
check_name() {
  [[ $name =~ ^[a-z0-9][a-z0-9_.-]{0,63}$ ]] || fail "bad name"
  for r in ca $RESERVED; do [ "$name" != "$r" ] || fail "$name is reserved"; done
}
# A certificate for a VPN client: TLS client authentication, and no server authentication.
is_client_cert() {
  local usage
  usage=$(openssl x509 -in "$1" -noout -ext extendedKeyUsage 2>/dev/null) || return 1
  [[ $usage == *"TLS Web Client Authentication"* && $usage != *"TLS Web Server Authentication"* ]]
}
[ ${#args[@]} -le 3 ] || fail "too many arguments"

# Rotating Kastellan's VPN key: `add-key OLD NEW` (run with OLD), then `keep-key NEW` (run with
# NEW). Only lines bound to this script (command="<this script>" with or without arguments)
# change. add-key copies the options of OLD's line exactly (its command=, from=, limits) with NEW
# as the key, so the new key may do what the old one may and nothing more; keep-key removes every
# other key line of this script (also ones added by whoever else held a key: a leaked key ends
# here) and says how many. Keys are one ed25519 key each (the base64 part only: no options, no
# other type). The new file is checked before it replaces the old one (BusyBox-safe).
keys_file() {
  if [ -n "${AUTHORIZED_KEYS:-}" ]; then echo "$AUTHORIZED_KEYS"
  elif [ "$(id -u)" = 0 ] && [ -f /etc/openwrt_release ] && ! pidof sshd >/dev/null 2>&1; then echo /etc/dropbear/authorized_keys
  else echo "$(awk -F: -v u="$(id -un)" '$1 == u { print $6 }' /etc/passwd)/.ssh/authorized_keys"
  fi
}
ed25519() {
  case $1 in AAAAC3NzaC1lZDI1NTE5AAAAI*) ;; *) fail "not an ed25519 key" ;; esac
  [ ${#1} -eq 68 ] && [ -z "$(printf '%s' "$1" | tr -d 'A-Za-z0-9+/')" ] || fail "not an ed25519 key"
}
rekey() {
  op=$1
  ed25519 "$2"
  [ "$op" = keep ] || ed25519 "$3"
  f=$(keys_file)
  [ -f "$f" ] || fail "no $f"
  tmp="$f.kastellan-new"
  rm -f "$tmp"
  counts=$(awk -v op="$op" -v a="$2" -v b="${3:-}" -v script="$0" -v out="$tmp" '
    # A line: its options (OPT), key type (TYPE) and key (KEY), by field; quoted options may hold
    # spaces; tabs separate as spaces do.
    function parse(s,   i, c, q, w) {
      sub(/\r$/, "", s); OPT = ""; TYPE = ""; KEY = ""
      sub(/^[ \t]+/, "", s)
      if (s == "" || substr(s, 1, 1) == "#") return
      if (s !~ /^(ssh-|ecdsa-|sk-)/) {
        q = 0
        for (i = 1; i <= length(s); i++) {
          c = substr(s, i, 1)
          if (c == "\"") q = !q
          else if (!q && (c == " " || c == "\t")) break
        }
        OPT = substr(s, 1, i - 1); s = substr(s, i)
        sub(/^[ \t]+/, "", s)
      }
      split(s, w, /[ \t]+/); TYPE = w[1]; KEY = w[2]
    }
    function bound(o,   p, after) {
      p = index(o, "command=\"" script)
      if (!p || (p > 1 && substr(o, p - 1, 1) != ",")) return 0
      after = substr(o, p + length("command=\"" script), 1)
      return after == "\"" || after == " "
    }
    {
      line[NR] = $0; parse($0); opt[NR] = OPT
      mine[NR] = OPT != "" && bound(OPT); k[NR] = TYPE == "ssh-ed25519" ? KEY : ""
    }
    END {
      for (i = 1; i <= NR; i++) if (mine[i]) { if (k[i] == a) src = i; if (k[i] == b) has = 1 }
      if (!src) { print "no line of this script with that key" > "/dev/stderr"; exit 3 }
      n = 0; removed = 0
      for (i = 1; i <= NR; i++) {
        if (op == "keep" && mine[i] && k[i] != a) { removed++; continue }
        print line[i] > out; n++
      }
      if (op == "add" && !has) { print opt[src] " ssh-ed25519 " b " kastellan-vpn" > out; n++ }
      close(out)
      print n " " removed
    }' "$f") || { rm -f "$tmp"; fail "$f not changed"; }
  # Every line written, each ended: else (a full disk) the file in place stays as it is.
  lines=$(wc -l < "$tmp" 2>/dev/null | tr -d ' ') || lines=
  if [ ! -s "$tmp" ] || [ "$lines" != "${counts%% *}" ]; then
    rm -f "$tmp"; fail "$f not changed (the new file came out short)"
  fi
  chmod 600 "$tmp" || { rm -f "$tmp"; fail "$f not changed (chmod)"; }
  mv "$tmp" "$f" || { rm -f "$tmp"; fail "$f not changed (mv)"; }
  if [ "$op" = keep ]; then echo "kept $2; removed ${counts#* } other key line(s)"; else echo "add-key done"; fi
}
case $command in
  add-key) rekey add "$name" "$days"; exit 0 ;;
  keep-key) rekey keep "$name"; exit 0 ;;
esac

cd "$EASYRSA_DIR" || fail "no $EASYRSA_DIR"

case $command in
  list)
    # pki/index.txt: status, expiry, revocation date, serial, file, subject (/CN=name).
    # Only client certificates (the server's and other certificates are not listed).
    # (awk splits on every tab; `read` would merge the empty revocation field of valid ones.)
    awk -F'\t' '{ print $1 "|" $2 "|" $4 "|" $6 }' pki/index.txt | while IFS='|' read -r status expiry serial subject; do
      cn=${subject##*/CN=}; cn=${cn%%/*}
      cert="pki/certs_by_serial/$serial.pem"
      [ -r "$cert" ] || cert="pki/revoked/certs_by_serial/$serial.crt"
      [ -r "$cert" ] || cert="pki/issued/$cn.crt"
      is_client_cert "$cert" || continue
      printf '%s\t%s\t%s\t%s\n' "$status" "$expiry" "$serial" "$cn"
    done
    ;;
  issue)
    check_name
    [[ $days =~ ^[0-9]{1,4}$ ]] && [ "$days" -ge 1 ] || fail "bad days"
    [ ! -e "pki/issued/$name.crt" ] || fail "$name exists"
    EASYRSA_CERT_EXPIRE=$days ./easyrsa --batch build-client-full "$name" nopass >/dev/null 2>&1 || fail "easyrsa failed"
    echo "issued $name"
    ;;
  revoke)
    check_name
    if [ -e "pki/issued/$name.crt" ]; then
      is_client_cert "pki/issued/$name.crt" || fail "$name is not a client certificate"
      ./easyrsa --batch revoke "$name" >/dev/null 2>&1 || fail "revoke failed"
    else
      # Revoked before (maybe the CRL didn't reach the server then): only renew the CRL.
      # The name as a fixed string (a "." in it is no wildcard): the DN ends with /CN=<name> or has it
      # before the next part.
      awk -F'\t' -v dn="/CN=$name" '$1 == "R" && (substr($6, length($6) - length(dn) + 1) == dn || index($6, dn "/")) { found = 1 }
        END { exit !found }' pki/index.txt || fail "no $name"
    fi
    ./easyrsa --batch gen-crl >/dev/null 2>&1 || fail "gen-crl failed"
    echo "revoked $name"
    ;;
  renew-crl)
    ./easyrsa --batch gen-crl >/dev/null 2>&1 || fail "gen-crl failed"
    echo "renewed"
    ;;
  crl)
    cat pki/crl.pem
    ;;
  export)
    check_name
    [ -e "pki/issued/$name.crt" ] && [ -e "pki/private/$name.key" ] || fail "no $name"
    is_client_cert "pki/issued/$name.crt" || fail "$name is not a client certificate"
    [ -r "$TEMPLATE" ] || fail "no template $TEMPLATE"
    tls=""
    if [ -n "$TLS_KEY" ]; then
      [ -r "$TLS_KEY" ] || fail "can't read the TLS key $TLS_KEY"
      tls=$(cat "$TLS_KEY")
    fi
    # Inline blocks: replace each {{...}} line with the file's contents.
    awk -v ca=pki/ca.crt -v crt="pki/issued/$name.crt" -v key="pki/private/$name.key" -v tls="$tls" '
      function dump(f,   line) { while ((getline line < f) > 0) print line; close(f) }
      function pem(f,   line, inside) {   # easy-rsa .crt files start with a text dump: PEM only
        while ((getline line < f) > 0) {
          if (line ~ /-----BEGIN CERTIFICATE-----/) inside = 1
          if (inside) print line
          if (line ~ /-----END CERTIFICATE-----/) inside = 0
        }
        close(f)
      }
      /\{\{ca\}\}/   { pem(ca); next }
      /\{\{cert\}\}/ { pem(crt); next }
      /\{\{key\}\}/  { dump(key); next }
      /\{\{tls\}\}/  { if (tls != "") print tls; next }
      { print }' "$TEMPLATE"
    ;;
  *)
    fail "unknown command"
    ;;
esac
