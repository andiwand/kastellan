# Go back to the image a container ran before its last update (kept by update-container as
# kastellan-previous:<name>): its reference (e.g. nginx:latest) is pointed at that image here,
# and the container recreated from its own settings, the same swap as an update (the current one
# comes back if the old image doesn't run steadily). The image it leaves is kept the same way, so
# going back can be undone. The next update pulls the newest again.
import signal

name = one_name()
signal.signal(signal.SIGHUP, signal.SIG_IGN)
lock = one_at_a_time()

old = exact(name)
if old is None:
    fail(f"no container called {name}")
ref = old["Config"]["Image"]
step(f"checking {name} ({ref})")
if "@" in ref or ref.startswith("sha256:"):
    fail("pinned to a digest: there is no going back by name")
replaceable(old, name)
try:
    previous = docker("GET", f"/images/{quote(PREVIOUS)}:{quote(name)}/json")
except Exception:
    fail("no previous image kept for it (only updates made by Kastellan keep one)")
current = old["Image"]
if previous["Id"] == current:
    fail("it already runs the previous image")
# Only an image of the same repository (from its registry), never something else tagged so.
if not from_registry(previous, ref):
    fail(f"the kept image isn't {ref}'s from its registry; not used")
mine = docker("GET", f"/images/{current}/json")
body, others = spec(old, mine.get("Config") or {})
labels = dict(body.get("Labels") or {})
back = labels.get(PREVIOUS_REF)
if back and back != ref and repo_of(back) == repo_of(ref) and "@" not in back:
    # The last update changed its tag: back to the tag it ran, which names the kept image again.
    try:
        had = docker("GET", f"/images/{quote(back, safe='/:')}/json")["Id"]
    except Exception:
        had = None
    step(f"pointing {back} at the previous image ({previous['Id'][7:19]})")
    tag(previous["Id"], back)
    body["Image"] = back
    labels[PREVIOUS_REF] = ref  # going back again returns to the tag it runs now
    undo = (lambda: tag(had, back)) if had and had != previous["Id"] else (lambda: None)
else:
    back = ref
    labels.pop(PREVIOUS_REF, None)
    step(f"pointing {ref} at the previous image ({previous['Id'][7:19]})")
    tag(previous["Id"], ref)
    undo = lambda: tag(current, ref)  # noqa: E731
body["Labels"] = labels
swap(old, name, body, others, undo=undo)
step("keeping the image it ran until now, to undo this")
try:
    tag(current, f"{PREVIOUS}:{name}")
except Exception as e:
    step(f"couldn't keep it: {e}")
done({"container": name, "image": back, "rolled_back": True, "from": current[7:19], "to": previous["Id"][7:19]})
