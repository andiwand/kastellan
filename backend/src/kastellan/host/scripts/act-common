#!/usr/bin/python3 -I -S
# Kastellan's actor: what every ability shares (prepended to each when installed). Runs as root
# through one sudo rule per ability; takes its one argument from the dispatcher and checks it
# again, against a pattern and the host's own list (/etc/kastellan/act/<ability>.allow, root's).
import http.client
import json
import os
import re
import socket
import sys
import syslog
import time

NAME = re.compile(r"[A-Za-z0-9][A-Za-z0-9_.-]{0,127}")  # used with fullmatch: no newline sneaks in
SOCKET = "/var/run/docker.sock"  # fixed: nothing from the environment steers a root script
ABILITY = os.path.basename(sys.argv[0])


STARTED = time.time()


def step(text):
    """A line on how far it got, for the hub to show while it runs (stderr, one line). Never
    fails: the hub may have gone, and the action goes on without anyone to tell."""
    try:
        sys.stderr.write("KASTELLAN-STEP " + " ".join(str(text).split())[:200] + "\n")
        sys.stderr.flush()
    except (OSError, ValueError):
        pass


def fail(message, code=1):
    # One line, as step() writes: a message carrying text from outside (a registry's error)
    # must not add lines the hub reads as steps.
    message = " ".join(str(message).split())[:500]
    syslog.syslog(syslog.LOG_WARNING, f"{ABILITY}: refused or failed: {message}")
    print(message, file=sys.stderr)
    sys.exit(code)


LOCK = "/run/kastellan-act.lock"


def one_at_a_time():
    """One changing action on this host at a time (a second one is refused, not queued)."""
    import fcntl

    handle = open(LOCK, "w")
    try:
        fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        fail("another action runs on this host; try again in a moment")
    return handle


def quote(text, safe=""):
    return "".join(c if c.isalnum() or c in "-._" + safe else f"%{ord(c):02X}" for c in text)


def exact(container):
    """The container called exactly `container`: Docker would also take an id or the start of
    one, which could be another container than the list means."""
    found = docker("GET", f"/containers/{quote(container)}/json", ok=(200, 404))
    if not isinstance(found, dict) or found.get("Name") != "/" + container:
        return None
    return found


def done(result):
    result = {**result, "seconds": round(time.time() - STARTED, 1)}
    syslog.syslog(syslog.LOG_NOTICE, f"{ABILITY}: {json.dumps(result)[:400]}")
    print(json.dumps(result))
    sys.exit(0)


def allowed(name):
    """Whether the host's own list lets Kastellan act on this container."""
    try:
        with open(f"/etc/kastellan/act/{ABILITY}.allow") as f:
            lines = [ln.strip() for ln in f if ln.strip() and not ln.startswith("#")]
    except OSError:
        return False
    return "*" in lines or name in lines


def one_name():
    if len(sys.argv) != 2 or not NAME.fullmatch(sys.argv[1]):
        fail("wrong arguments", 2)
    if not allowed(sys.argv[1]):
        fail(f"{sys.argv[1]} isn't on this host's list for {ABILITY}", 3)
    return sys.argv[1]


class _Unix(http.client.HTTPConnection):
    def __init__(self, timeout):
        super().__init__("docker", timeout=timeout)

    def connect(self):
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.settimeout(self.timeout)
        self.sock.connect(SOCKET)


TESTED_API = (1, 52)  # the newest Docker API version these scripts were checked against
_api = []


def api_version():
    """The API version to speak: the daemon's newest, up to TESTED_API, but never below what it
    accepts (Docker 29 refuses anything older than 1.44; Docker 20 knows nothing past 1.41)."""
    if not _api:
        conn = _Unix(15)
        conn.request("GET", "/version")  # unversioned: answered by every daemon
        r = conn.getresponse()
        info = json.loads(r.read() or b"{}") if r.status == 200 else {}
        conn.close()

        def parse(text, default):
            try:
                return tuple(int(x) for x in str(text).split(".")[:2])
            except ValueError:
                return default

        newest = parse(info.get("ApiVersion"), (1, 41))
        oldest = parse(info.get("MinAPIVersion"), (1, 12))
        _api.append(max(oldest, min(newest, TESTED_API)))
    return "/v%d.%d" % _api[0]


def docker(method, path, body=None, timeout=60, ok=(200, 201, 204, 304)):
    """One call to the Docker API; the JSON answer (or None). Fixed paths built here, never a
    string from outside except a checked container name."""
    prefix = api_version()
    conn = _Unix(timeout)
    headers = {"Content-Type": "application/json"} if body is not None else {}
    conn.request(method, prefix + path, body=json.dumps(body) if body is not None else None, headers=headers)
    r = conn.getresponse()
    data = r.read()
    conn.close()
    if r.status not in ok:
        try:
            message = json.loads(data).get("message", "")
        except ValueError:
            message = data[:200].decode(errors="replace")
        raise RuntimeError(f"{method} {path.split('?')[0]}: {r.status} {message}")
    if not data:
        return None
    try:
        return json.loads(data)
    except ValueError:
        return data.decode(errors="replace")
