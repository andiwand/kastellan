#!/usr/bin/python3 -I -S
# Kastellan's collector: reads how a Linux host is doing and prints it as JSON. Nothing else.
#
# Installed root-owned at /usr/local/lib/kastellan/collect, run as root through one sudo rule of
# the user kastellan-collect, whose SSH key may run only this (command= in authorized_keys).
# It takes no input and no arguments, runs no shell, and writes only its SMART cache (in /run,
# root's): disk health is read every 20 minutes, and never wakes a sleeping disk. Docker is read
# through its API (lists only: never a container's environment, which may hold passwords).
import hashlib
import json
import os
import re
import socket
import subprocess
import sys
import time
from urllib.parse import quote

OUT = {"version": 1, "time": int(time.time()), "errors": {}}
# Which collector this is, so the hub can tell an older one (a hash of this file, as installed).
try:
    with open(__file__, "rb") as f:
        OUT["script"] = hashlib.sha256(f.read()).hexdigest()[:16]
except (NameError, OSError):
    pass


def section(name):
    def wrap(fn):
        try:
            OUT[name] = fn()
        except Exception as e:  # one part failing never hides the rest
            OUT["errors"][name] = f"{type(e).__name__}: {e}"[:200]
        return fn

    return wrap


def read(path):
    with open(path, errors="surrogateescape") as f:
        return f.read()


def unescape(text):
    """/proc/mounts writes space, tab, newline and backslash as \\NNN (octal)."""
    return re.sub(r"\\([0-7]{3})", lambda m: chr(int(m.group(1), 8)), text)


def run(argv, timeout=20):
    """A fixed program with fixed arguments; never a shell."""
    r = subprocess.run(argv, capture_output=True, text=True, timeout=timeout, env={"PATH": "/usr/sbin:/usr/bin:/sbin:/bin", "LC_ALL": "C"})
    return r.returncode, r.stdout


def cpu_times():
    try:
        return [int(x) for x in read("/proc/stat").splitlines()[0].split()[1:9]]
    except (OSError, ValueError, IndexError):
        return None


@section("system")
def system():
    load = read("/proc/loadavg").split()
    mem = {}
    for line in read("/proc/meminfo").splitlines():
        key, _, value = line.partition(":")
        mem[key] = int(value.split()[0]) * 1024 if value.split() else 0
    return {
        "hostname": socket.gethostname(),
        "kernel": os.uname().release,
        "uptime": float(read("/proc/uptime").split()[0]),
        "load": [float(x) for x in load[:3]],
        "cpus": os.cpu_count(),
        # CPU time counters (user nice system idle iowait irq softirq steal): the hub makes a
        # percentage from two readings.
        "cpu": cpu_times(),
        "memory": {"total": mem.get("MemTotal", 0), "available": mem.get("MemAvailable", 0)},
        "swap": {"total": mem.get("SwapTotal", 0), "free": mem.get("SwapFree", 0)},
    }


REAL_FS = {"ext2", "ext3", "ext4", "xfs", "btrfs", "zfs", "f2fs", "vfat", "exfat", "ntfs", "ntfs3", "jfs", "reiserfs", "bcachefs"}


@section("filesystems")
def filesystems():
    out, seen = [], set()
    for line in read("/proc/mounts").splitlines():
        parts = line.split()
        if len(parts) < 3 or parts[2] not in REAL_FS or parts[0].startswith("/dev/loop"):
            continue
        dev, mount, kind = unescape(parts[0]), unescape(parts[1]), parts[2]
        if dev in seen or mount.startswith(("/snap/", "/var/lib/docker/", "/run/")):
            continue
        seen.add(dev)
        try:
            st = os.statvfs(mount)
        except OSError:
            continue  # gone since /proc/mounts was read, or unreadable: the others still count
        total = st.f_blocks * st.f_frsize
        if not total:
            continue
        out.append({
            "mount": mount.encode("utf-8", "replace").decode("utf-8", "replace"),
            "device": dev.encode("utf-8", "replace").decode("utf-8", "replace"), "type": kind, "total": total,
            "used": (st.f_blocks - st.f_bfree) * st.f_frsize, "available": st.f_bavail * st.f_frsize,
        })
    return out


@section("raid")
def raid():
    if not os.path.exists("/proc/mdstat"):
        return []
    arrays, current = [], None
    levels = ("raid0", "raid1", "raid4", "raid5", "raid6", "raid10", "linear", "multipath")
    for line in read("/proc/mdstat").splitlines():
        m = re.match(r"^(md\w+) : (\w+)\s*(.*)$", line)
        if m:
            words = [w for w in m.group(3).split() if not w.startswith("(")]  # (auto-read-only)
            level = words[0] if words and words[0] in levels else ""
            members = re.findall(r"([\w-]+)\[\d+\](\([A-Z]\))?", m.group(3))
            current = {
                "name": m.group(1), "active": m.group(2) == "active", "level": level,
                "devices": [d for d, _ in members], "failed": [d for d, f in members if f == "(F)"],
                "status": "", "progress": None,
            }
            arrays.append(current)
            continue
        if current is None:
            continue
        s = re.search(r"\[([U_]+)\]", line)
        if s:
            current["status"] = s.group(1)
        p = re.search(r"(resync|recovery|reshape|check)\s*=\s*([\d.]+)%", line)
        if p:
            current["progress"] = {"what": p.group(1), "percent": float(p.group(2))}
    return arrays


def disks():
    out = []
    for name in sorted(os.listdir("/sys/block")):
        if re.match(r"^(sd[a-z]+|nvme\d+n\d+|vd[a-z]+|hd[a-z]+)$", name):
            out.append(name)
    return out


SMART_CACHE = "/run/kastellan-collect/smart.json"  # root's, in memory: one read per 20 min
SMART_EVERY = 20 * 60


@section("smart")
def smart():
    try:
        with open(SMART_CACHE) as f:
            cached = json.load(f)
        if time.time() - cached.get("time", 0) < SMART_EVERY:
            return cached["smart"]
    except (OSError, ValueError, KeyError):
        pass
    smartctl = next((p for p in ("/usr/sbin/smartctl", "/usr/bin/smartctl", "/sbin/smartctl") if os.path.exists(p)), None)
    if smartctl is None:
        return {"available": False, "disks": []}
    out, budget = [], time.monotonic() + 45
    for name in disks():
        if time.monotonic() > budget:
            out.append({"disk": name, "error": "not read (time ran out)"})
            continue
        # -n standby: a disk that sleeps is left asleep (SMART would wake it every time).
        code, text = run([smartctl, "-j", "-n", "standby", "-H", "-A", "-i", f"/dev/{name}"], timeout=15)
        try:
            j = json.loads(text)
        except ValueError:
            out.append({"disk": name, "error": "no answer"})
            continue
        if (j.get("power_mode") or {}).get("name") == "STANDBY" or code & 2 and "standby" in text.lower():
            out.append({"disk": name, "asleep": True})
            continue
        attrs = {a.get("id"): a.get("raw", {}).get("value") for a in j.get("ata_smart_attributes", {}).get("table", [])}
        nvme = j.get("nvme_smart_health_information_log") or {}
        out.append({
            "disk": name,
            "model": j.get("model_name"),
            "passed": j.get("smart_status", {}).get("passed"),
            "temperature": (j.get("temperature") or {}).get("current"),
            "power_on_hours": (j.get("power_on_time") or {}).get("hours"),
            "reallocated": attrs.get(5),
            "pending": attrs.get(197),
            "uncorrectable": attrs.get(198),
            "nvme_used_percent": nvme.get("percentage_used"),
            "nvme_media_errors": nvme.get("media_errors"),
        })
    result = {"available": True, "disks": out}
    try:
        os.makedirs(os.path.dirname(SMART_CACHE), mode=0o700, exist_ok=True)
        with open(SMART_CACHE + ".new", "w") as f:
            json.dump({"time": time.time(), "smart": result}, f)
        os.replace(SMART_CACHE + ".new", SMART_CACHE)
    except OSError:
        pass
    return result


@section("temperatures")
def temperatures():
    out = []
    base = "/sys/class/hwmon"
    for h in sorted(os.listdir(base)) if os.path.isdir(base) else []:
        path = os.path.join(base, h)
        try:
            chip = read(os.path.join(path, "name")).strip()
        except OSError:
            continue
        for f in sorted(os.listdir(path)):
            m = re.match(r"^temp(\d+)_input$", f)
            if not m:
                continue
            try:
                value = int(read(os.path.join(path, f)).strip()) / 1000
            except (OSError, ValueError):
                continue
            if not 1 <= value <= 150:
                continue  # an input with nothing connected (0, or 216 °C)
            limit = None
            for kind in ("crit", "max"):  # the chip's own limit, where it gives one
                try:
                    v = int(read(os.path.join(path, f"temp{m.group(1)}_{kind}")).strip()) / 1000
                    if 20 <= v <= 150:
                        limit = v
                        break
                except (OSError, ValueError):
                    pass
            label = chip
            try:
                label = f"{chip} {read(os.path.join(path, f'temp{m.group(1)}_label')).strip()}"
            except OSError:
                pass
            out.append({"sensor": label[:60], "celsius": value, "limit": limit})
    return out[:40]


@section("services")
def services():
    code, text = run(["systemctl", "list-units", "--state=failed", "--no-legend", "--plain", "--no-pager"])
    failed = [line.split()[0] for line in text.splitlines() if line.split()]
    return {"failed": failed[:50]}


@section("updates")
def updates():
    out = {"reboot": os.path.exists("/var/run/reboot-required"), "available": None, "security": None}
    # Debian has no reboot-required file without unattended-upgrades: a newer kernel installed
    # than the one running says it too.
    try:
        def key(v):
            return [int(x) if x.isdigit() else x for x in re.split(r"[.-]", v)]
        kernels = [f[len("vmlinuz-"):] for f in os.listdir("/boot") if f.startswith("vmlinuz-")]
        newest = max(kernels, key=key) if kernels else None
        if newest and newest != os.uname().release:
            out["reboot"] = True
    except (OSError, ValueError, TypeError):
        pass
    try:
        out["reboot_for"] = read("/var/run/reboot-required.pkgs").split()[:20]
    except OSError:
        out["reboot_for"] = []
    apt = next((p for p in ("/usr/bin/apt-get", "/bin/apt-get") if os.path.exists(p)), None)
    if apt:
        # What an upgrade would install, as apt sees it now (its lists are refreshed by the
        # system's daily apt timer): a dry run (-s) changes nothing and takes no lock.
        code, text = run([apt, "-s", "-o", "Debug::NoLocking=1", "--with-new-pkgs", "upgrade"], timeout=60)
        if code == 0:
            inst = [ln for ln in text.splitlines() if ln.startswith("Inst ")]
            out["available"] = len(inst)
            out["security"] = sum(1 for ln in inst if "-security" in ln)
            out["packages"] = sorted({ln.split()[1] for ln in inst})[:50]
            return out
    try:
        text = read("/var/lib/update-notifier/updates-available")
        m = re.search(r"(\d+) updates? can be applied", text)
        out["available"] = int(m.group(1)) if m else (0 if "0 updates" in text else None)
        s = re.search(r"(\d+) of these updates (?:is a|are) (?:standard )?security update", text)
        out["security"] = int(s.group(1)) if s else 0
    except OSError:
        pass
    return out


def docker_get(path):
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(15)
    s.connect("/var/run/docker.sock")
    s.sendall(f"GET {path} HTTP/1.0\r\nHost: docker\r\n\r\n".encode())
    data = b""
    while chunk := s.recv(65536):
        data += chunk
    s.close()
    head, _, body = data.partition(b"\r\n\r\n")
    if not head.startswith(b"HTTP/1.") or b" 200 " not in head.split(b"\r\n")[0]:
        raise OSError(head.split(b"\r\n")[0].decode(errors="replace"))
    return json.loads(body)


@section("docker")
def docker():
    if not os.path.exists("/var/run/docker.sock"):
        return None
    out, digests = [], {}
    # The images the actor kept from before an update (kastellan-previous:<container>).
    previous = {}
    try:
        flt = quote(json.dumps({"reference": ["kastellan-previous"]}))
        for image in docker_get(f"/images/json?filters={flt}") or []:
            for t in image.get("RepoTags") or []:
                if t.startswith("kastellan-previous:"):
                    previous[t.split(":", 1)[1]] = image.get("Id", "")
    except Exception:
        pass
    for c in docker_get("/containers/json?all=1"):
        image_id = c.get("ImageID", "")
        if image_id not in digests:
            try:
                digests[image_id] = docker_get(f"/images/{image_id}/json").get("RepoDigests") or []
            except Exception:
                digests[image_id] = []
        name = (c.get("Names") or ["?"])[0].lstrip("/")
        before = previous.get(name)
        labels = c.get("Labels") or {}
        out.append({
            # Set up with compose: its file names the tag (a tag changed here would go back).
            "compose": labels.get("com.docker.compose.project.config_files")
            or labels.get("com.docker.compose.project"),
            "name": name,
            "previous": before[7:19] if before and before != image_id else None,
            "image": c.get("Image", ""),
            "image_id": image_id,
            "digests": digests[image_id],
            "state": c.get("State", ""),
            "status": c.get("Status", ""),
            # The host's ports it publishes: which service of the host it is (a check on one).
            "ports": sorted({p["PublicPort"] for p in c.get("Ports") or [] if p.get("PublicPort")}),
        })
    return out


VIRSH = ("/usr/bin/virsh", "/usr/sbin/virsh", "/bin/virsh")  # where libvirt's client lives
LIBVIRT = "qemu:///system"


def kib(text):
    m = re.match(r"(\d+)\s*KiB", text or "")
    return int(m.group(1)) * 1024 if m else None


VMS_WITHIN = 25  # seconds for all VMs: slow libvirt mustn't cost the whole report its time


@section("vms")
def vms():
    """libvirt's virtual machines (KVM): name, state, autostart, CPUs, memory, disks. Nothing
    from their definitions beyond that (no XML: it can carry passwords for consoles). Read-only
    (virsh -r), each VM asked by its UUID (virsh takes a number as a domain id first)."""
    virsh = next((p for p in VIRSH if os.path.exists(p)), None)
    if virsh is None:
        return None
    base = [virsh, "-r", "-c", LIBVIRT]
    end = time.monotonic() + VMS_WITHIN
    code, text = run([*base, "list", "--all", "--uuid", "--name"], timeout=20)
    if code != 0:
        raise RuntimeError("virsh list failed (is libvirtd running?)")
    listed = [line.split() for line in text.splitlines()]
    out, skipped = [], []
    for uuid, name in [p for p in listed if len(p) == 2][:64]:
        if time.monotonic() >= end:
            skipped.append(name)
            continue
        try:
            _, info = run([*base, "dominfo", "--", uuid], timeout=max(0.01, min(10, end - time.monotonic())))
            _, blk = run([*base, "domblklist", "--details", "--", uuid], timeout=max(0.01, min(10, end - time.monotonic())))
        except subprocess.TimeoutExpired:  # a domain stuck in a job: the others still count
            skipped.append(name)
            continue
        fields = {}
        for line in info.splitlines():
            key, _, value = line.partition(":")
            fields[key.strip().lower()] = value.strip()
        disks = []
        for line in blk.splitlines()[2:]:
            words = line.split()
            if len(words) >= 4 and words[1] == "disk" and words[3] != "-":
                disks.append({"target": words[2], "source": words[3]})
        cpus = fields.get("cpu(s)", "")
        out.append({
            "name": name,
            "uuid": uuid,
            "state": fields.get("state"),
            "autostart": fields.get("autostart") == "enable",
            "persistent": fields.get("persistent") == "yes",
            "vcpus": int(cpus) if cpus.isdigit() else None,
            "memory": kib(fields.get("max memory")),
            "memory_used": kib(fields.get("used memory")),
            "disks": disks[:16],
        })
    if skipped:
        OUT["errors"]["vms"] = f"libvirt didn't answer in time for: {', '.join(skipped[:10])}"[:200]
    return out


APCACCESS = ("/usr/sbin/apcaccess", "/sbin/apcaccess", "/usr/bin/apcaccess")  # apcupsd's client
UPSC = ("/usr/bin/upsc", "/bin/upsc", "/usr/sbin/upsc")  # NUT's client (localhost, read-only)
# What a UPS's status words mean, as a few flags (apcupsd's STATUS, NUT's ups.status).
UPS_FLAGS = {
    "ONLINE": "online", "OL": "online",
    "ONBATT": "on_battery", "OB": "on_battery",
    "LOWBATT": "low_battery", "LB": "low_battery",
    "REPLACEBATT": "replace_battery", "RB": "replace_battery",
    "COMMLOST": "no_contact",
    "OFF": "on_battery",  # NUT: its output is off (mains gone, or shut down)
}


def number(text):
    """The number a value starts with ("98.0 Percent", "230.0 Volts", "12.5 Minutes")."""
    m = re.match(r"\s*(-?\d+(?:\.\d+)?)", text or "")
    return float(m.group(1)) if m else None


def ups_flags(status):
    text = (status or "").upper()
    words = text.split()
    flags = []
    # Shutting down for a low battery: apcupsd says so in place of its usual words, NUT says FSD.
    if "SHUTTING DOWN" in text:
        flags += ["on_battery", "low_battery"]
    if "FSD" in words:
        flags += ["low_battery"] + (["on_battery"] if "OL" not in words else [])
    for word in words:
        flag = UPS_FLAGS.get(word)
        if flag and flag not in flags:
            flags.append(flag)
    return list(dict.fromkeys(flags)) or ["unknown"]


def parse_apcaccess(text):
    """`apcaccess status`: `KEY      : value` lines."""
    f = {}
    for line in text.splitlines():
        key, sep, value = line.partition(":")
        if sep:
            f[key.strip().upper()] = value.strip()
    minutes = number(f.get("TIMELEFT"))
    transfers = number(f.get("NUMXFERS"))
    return {
        "source": "apcupsd",
        "name": f.get("UPSNAME") or None,
        "model": f.get("MODEL") or None,
        "serial": f.get("SERIALNO") or None,
        "firmware": f.get("FIRMWARE") or None,
        "status": f.get("STATUS") or "",
        "flags": ups_flags(f.get("STATUS")),
        "charge": number(f.get("BCHARGE")),
        "runtime": minutes * 60 if minutes is not None else None,
        "load": number(f.get("LOADPCT")),
        "input_voltage": number(f.get("LINEV")),
        "battery_voltage": number(f.get("BATTV")),
        "nominal_power": number(f.get("NOMPOWER")),
        "last_transfer": f.get("LASTXFER") or None,
        "on_battery_since": f.get("XONBATT") or None,
        "off_battery_since": f.get("XOFFBATT") or None,
        "transfers": int(transfers) if transfers is not None else None,
        "battery_date": f.get("BATTDATE") or None,
    }


def parse_upsc(name, text):
    """`upsc <ups>`: `key: value` lines (NUT's variables)."""
    f = {}
    for line in text.splitlines():
        key, sep, value = line.partition(":")
        if sep:
            f[key.strip()] = value.strip()
    return {
        "source": "nut",
        "name": name,
        "model": f.get("ups.model") or f.get("device.model") or None,
        "serial": f.get("ups.serial") or f.get("device.serial") or None,
        "firmware": f.get("ups.firmware") or None,
        "status": f.get("ups.status") or "",
        "flags": ups_flags(f.get("ups.status")),
        "charge": number(f.get("battery.charge")),
        "runtime": number(f.get("battery.runtime")),  # seconds already
        "load": number(f.get("ups.load")),
        "input_voltage": number(f.get("input.voltage")),
        "battery_voltage": number(f.get("battery.voltage")),
        "nominal_power": number(f.get("ups.realpower.nominal")),
        "last_transfer": f.get("input.transfer.reason") or None,
        "on_battery_since": None,
        "off_battery_since": None,
        "transfers": None,
        "battery_date": f.get("battery.date") or f.get("battery.mfr.date") or None,
    }


UPS_WITHIN = 15  # seconds for all UPS tools, so a dead daemon can't cost the whole host report


@section("ups")
def ups():
    """The UPSes this host reads: apcupsd's (apcaccess) and NUT's (upsc, on this host). Nothing
    but their state; no tool, no section. One the daemon can't reach is there, without contact."""
    out = []
    end = time.monotonic() + UPS_WITHIN

    def ask(argv):
        left = end - time.monotonic()
        if left <= 0:
            return 1, ""
        try:
            return run(argv, timeout=min(10, left))
        except (subprocess.TimeoutExpired, OSError):
            return 1, ""

    apc = next((p for p in APCACCESS if os.path.exists(p)), None)
    if apc is not None:
        code, text = ask([apc, "status"])
        if code == 0 and "STATUS" in text:
            out.append(parse_apcaccess(text))
        else:
            out.append({"source": "apcupsd", "status": "", "flags": ["no_contact"]})
    upsc = next((p for p in UPSC if os.path.exists(p)), None)
    if upsc is not None:
        code, text = ask([upsc, "-l"])
        for name in [n.strip() for n in text.splitlines() if n.strip()][:8] if code == 0 else []:
            if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]{0,63}", name):
                continue
            code, data = ask([upsc, name])
            if code == 0 and "ups.status" in data:
                out.append(parse_upsc(name, data))
            else:
                out.append({"source": "nut", "name": name, "status": "", "flags": ["no_contact"]})
    # apcupsd installed but not running while NUT answers: the UPS is NUT's, not one out of reach.
    if any(u["source"] == "nut" and "no_contact" not in u["flags"] for u in out):
        out = [u for u in out if not (u["source"] == "apcupsd" and u["flags"] == ["no_contact"])]
    return out or None


sys.stdout.write(json.dumps(OUT))
