# Update one container (on the host's list): pull its image again (same reference, e.g.
# nginx:1.27 or app:latest; never another one, and only if it came from that registry), and if
# that brought a newer image, recreate the container from its own settings with it. The old one
# stays (stopped, renamed) until the new one runs steadily (and is healthy, if it has a health
# check); if it doesn't, the old one comes back. The image it ran before is kept (tagged
# kastellan-previous:<name>) for rollback-container. One update at a time (a lock in /run).
import signal

name = one_name()
signal.signal(signal.SIGHUP, signal.SIG_IGN)  # a dropped connection doesn't stop it half-way


def too_long(*_):
    raise TimeoutError("the pull took too long")


signal.signal(signal.SIGALRM, too_long)
lock = one_at_a_time()


def pull(ref):
    image, tag = (ref.rsplit(":", 1) if ":" in ref.rsplit("/", 1)[-1] else (ref, "latest"))
    raw = docker("POST", f"/images/create?fromImage={quote(image)}&tag={quote(tag)}", timeout=300)
    # A stream of JSON lines (or one object); an error is one of them.
    items = [raw] if isinstance(raw, dict) else []
    for line in (raw if isinstance(raw, str) else "").splitlines():
        try:
            items.append(json.loads(line))
        except ValueError:
            continue
    for item in items:
        # "error" until API 1.47; "errorDetail" from 1.48 on (where "error" may stay empty).
        detail = (item.get("errorDetail") or {}) if isinstance(item, dict) else {}
        message = (item.get("error") if isinstance(item, dict) else None) or (
            detail.get("message") if isinstance(detail, dict) else None
        )
        if message:
            raise RuntimeError(f"pull: {str(message)[:200]}")


old = exact(name)
if old is None:
    fail(f"no container called {name}")
ref = old["Config"]["Image"]
step(f"checking {name} ({ref})")
if "@" in ref:
    fail("pinned to a digest: nothing to update")
replaceable(old, name)

before = old["Image"]
mine = docker("GET", f"/images/{before}/json")
# Only an image that came from that registry: a locally built one would be replaced by whatever
# someone publishes under the same name.
if not from_registry(mine, ref):
    fail(f"{ref} wasn't pulled from its registry (built here?): not replaced from there")
step(f"pulling {ref}")
try:
    signal.alarm(900)  # the pull, all of it
    pull(ref)
    signal.alarm(0)
    after = docker("GET", f"/images/{quote(ref, safe='/:')}/json")["Id"]
except Exception as e:
    signal.alarm(0)
    fail(f"{ref}: {e}")
step("comparing the pulled image with the running one")
if after == before:
    done({"container": name, "image": ref, "updated": False, "why": "already the newest image"})

body, others = spec(old, mine.get("Config") or {})
swap(old, name, body, others)
# The image it ran before keeps a name, so `docker image prune` leaves it and rollback-container
# can go back to it.
step("keeping the previous image for going back")
try:
    tag(before, f"{PREVIOUS}:{name}")
except Exception as e:
    step(f"couldn't keep the previous image: {e}")
done({"container": name, "image": ref, "updated": True, "from": before[7:19], "to": after[7:19]})
