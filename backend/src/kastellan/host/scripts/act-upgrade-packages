# Install the system's pending updates (Debian, Ubuntu): apt-get update, then upgrade with new
# dependencies (a new kernel) but never removing a package, and keeping changed config files.
# No argument. Says what it installed, and whether the host now wants a reboot.
import shutil
import subprocess

if len(sys.argv) != 1:
    fail("wrong arguments", 2)
lock = one_at_a_time()
apt = shutil.which("apt-get", path="/usr/bin:/bin")
if apt is None:
    fail("no apt-get here: only Debian and Ubuntu hosts for now")
ENV = {  # fixed: nothing from outside steers what root runs
    "PATH": "/usr/sbin:/usr/bin:/sbin:/bin",
    "DEBIAN_FRONTEND": "noninteractive",
    "LC_ALL": "C",
}
KEEP = ["-o", "Dpkg::Options::=--force-confdef", "-o", "Dpkg::Options::=--force-confold"]


def apt_get(*args, timeout=900):
    """apt-get, never killed halfway (that can leave dpkg broken): past `timeout` the answer is
    that it still runs, and it goes on by itself."""
    process = subprocess.Popen([apt, *args], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, env=ENV)
    try:
        stdout, stderr = process.communicate(timeout=timeout)
    except subprocess.TimeoutExpired:
        fail(f"apt-get {args[-1]} still runs after {timeout // 60} minutes; it goes on by itself (see the host's apt logs)")
    r = subprocess.CompletedProcess(process.args, process.returncode, stdout, stderr)
    if r.returncode != 0:
        text = (r.stderr or r.stdout).strip()
        if "Could not get lock" in text or "is held by process" in text:
            fail("apt is busy (another update runs, e.g. unattended-upgrades): try again later")
        fail(text.splitlines()[-1][:300] if text else f"apt-get {args[0]} failed")
    return r.stdout


def newer_kernel():
    """A newer kernel installed than the one running (Debian has no reboot-required file without
    unattended-upgrades)."""
    def key(v):
        return [int(x) if x.isdigit() else x for x in re.split(r"[.-]", v)]
    try:
        installed = [f[len("vmlinuz-"):] for f in os.listdir("/boot") if f.startswith("vmlinuz-")]
        return bool(installed) and max(installed, key=key) != os.uname().release
    except (OSError, ValueError, TypeError):
        return False


dpkg = shutil.which("dpkg", path="/usr/bin:/bin")
if dpkg:
    # An earlier run that was interrupted (a power cut) left packages half set up: finish them.
    subprocess.run([dpkg, "--configure", "-a", "--force-confdef", "--force-confold"],
                   capture_output=True, env=ENV, timeout=1200)
apt_get("update", timeout=300)
out = apt_get("-y", "--with-new-pkgs", *KEEP, "upgrade", timeout=2400)
names = sorted({m.group(1) for m in re.finditer(r"^(?:Setting up|Unpacking) ([^\s:]+)", out, re.M)})
done({
    "upgraded": len(names),
    "packages": names[:30],
    "reboot": os.path.exists("/var/run/reboot-required") or newer_kernel(),
})
