# Install the system's pending updates (Debian, Ubuntu): apt-get update, then upgrade with new
# dependencies (a new kernel) but never removing a package, and keeping changed config files.
# No argument. Says what it installed, and whether the host now wants a reboot.
import shutil
import subprocess

if len(sys.argv) != 1:
    fail("wrong arguments", 2)
lock = one_at_a_time()
apt = shutil.which("apt-get", path="/usr/bin:/bin")
if apt is None:
    fail("no apt-get here: only Debian and Ubuntu hosts for now")
ENV = {  # fixed: nothing from outside steers what root runs
    "PATH": "/usr/sbin:/usr/bin:/sbin:/bin",
    "DEBIAN_FRONTEND": "noninteractive",
    "LC_ALL": "C",
}
KEEP = ["-o", "Dpkg::Options::=--force-confdef", "-o", "Dpkg::Options::=--force-confold"]


LOG = "/var/log/kastellan-upgrade.log"  # root's: apt's and dpkg's words, also past a timeout


def run(command, what, timeout):
    """A command never killed halfway (that can leave dpkg broken): past `timeout` the answer is
    that it still runs, and it goes on by itself. Its output goes to LOG, not a pipe: a pipe
    nobody reads any more would kill it (SIGPIPE) at its next line."""
    # Bytes, decoded line by line with replacement: a maintainer script's odd byte, or a
    # character apt has only half written yet, must never stop the run halfway.
    with open(LOG, "a+b") as log:
        start = log.seek(0, os.SEEK_END)
        process = subprocess.Popen(command, stdin=subprocess.DEVNULL, stdout=log, stderr=subprocess.STDOUT, env=ENV)
        deadline, seen, rest = time.time() + timeout, start, b""
        while True:
            try:
                process.wait(timeout=2)
                break
            except subprocess.TimeoutExpired:
                pass
            # Which package it is at, from what apt wrote so far (whole lines only).
            log.seek(seen)
            rest += log.read()
            seen = log.tell()
            *whole, rest = rest.split(b"\n")
            for line in (w.decode("utf-8", errors="replace") for w in whole):
                if m := re.match(r"(Unpacking|Setting up) ([^\s:]+)", line):
                    step(f"{m.group(1).lower()} {m.group(2)}")
            if time.time() > deadline:
                fail(f"{what} still runs after {timeout // 60} minutes; it goes on by itself (see {LOG})")
        log.seek(start)
        text = log.read().decode("utf-8", errors="replace")
    if process.returncode != 0:
        if "Could not get lock" in text or "is held by process" in text:
            fail("apt is busy (another update runs, e.g. unattended-upgrades): try again later")
        lines = text.strip().splitlines()
        fail(lines[-1][:300] if lines else f"{what} failed")
    return text


def apt_get(*args, timeout):
    return run([apt, *args], f"apt-get {args[-1]}", timeout)


def newer_kernel():
    """A newer kernel installed than the one running (Debian has no reboot-required file without
    unattended-upgrades)."""
    def key(v):
        return [int(x) if x.isdigit() else x for x in re.split(r"[.-]", v)]
    try:
        installed = [f[len("vmlinuz-"):] for f in os.listdir("/boot") if f.startswith("vmlinuz-")]
        return bool(installed) and max(installed, key=key) != os.uname().release
    except (OSError, ValueError, TypeError):
        return False


dpkg = shutil.which("dpkg", path="/usr/bin:/bin")
if dpkg:
    # An earlier run that was interrupted (a power cut) left packages half set up: finish them.
    step("finishing package setups an earlier run left halfway")
    run([dpkg, "--configure", "-a", "--force-confdef", "--force-confold"], "dpkg --configure", 1200)
step("refreshing the package lists")
apt_get("update", timeout=300)
step("installing the updates")
out = apt_get("-y", "--with-new-pkgs", *KEEP, "upgrade", timeout=2400)
step("checking whether it needs a reboot")
names = sorted({m.group(1) for m in re.finditer(r"^(?:Setting up|Unpacking) ([^\s:]+)", out, re.M)})
done({
    "upgraded": len(names),
    "packages": names[:30],
    "reboot": os.path.exists("/var/run/reboot-required") or newer_kernel(),
})
