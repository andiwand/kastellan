#!/usr/bin/python3 -I -S
# Kastellan's actor: the only thing its SSH key may run (command= in authorized_keys). Runs as
# the user kastellan-act, which can do nothing by itself; each ability is a root-owned script
# with its own sudo rule, installed only if chosen. This reads the requested action from
# SSH_ORIGINAL_COMMAND, accepts exactly the known forms, and starts the ability through sudo
# with the checked argument (never a shell). The ability checks it again.
import hashlib
import os
import re
import sys

BASE = "/usr/local/lib/kastellan/act"
NAME = re.compile(r"[A-Za-z0-9][A-Za-z0-9_.-]{0,127}")  # with fullmatch
VM_NAME = re.compile(  # libvirt allows more; Kastellan this much, and never a number or a UUID:
    r"(?!\d+$)(?![0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$)"
    r"[A-Za-z0-9][A-Za-z0-9_.+-]{0,127}"  # virsh reads those as a domain id or UUID first
)
TAG = re.compile(r"[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}")  # an image tag, as Docker allows (fullmatch)
UNIT = re.compile(r"[A-Za-z0-9][A-Za-z0-9@_.:-]{0,200}\.(service|socket|timer|mount|path|target)")
FORMS = {
    "update-container": NAME,  # pull its image (or a tag of it), recreate it with the same settings
    "rollback-container": NAME,  # back to the image it ran before its last update
    "restart-container": NAME,
    "start-container": NAME,
    "stop-container": NAME,
    "container-logs": NAME,  # reads only: the last lines of its log
    "unit-logs": UNIT,  # reads only: the last lines of a systemd unit's journal
    "journal": re.compile(r"-|[A-Za-z0-9=;]{1,400}"),  # reads only: the journal after a cursor
    "docker-logs": re.compile(r"-|\d{1,12}(\.\d{1,9})?"),  # reads only: containers' logs since a time
    "vm-start": VM_NAME,  # libvirt's virtual machines
    "vm-shutdown": VM_NAME,
    "vm-reboot": VM_NAME,
    "vm-force-off": VM_NAME,
    "upgrade-packages": None,  # apt-get update and upgrade (keeps config files, removes nothing)
    "reboot": None,  # in a minute (shutdown -r +1), so it can still be cancelled on the host
}

words = os.environ.get("SSH_ORIGINAL_COMMAND", "").split()
installed = sorted(a for a in FORMS if os.path.isfile(os.path.join(BASE, a)))

if words == ["abilities"]:
    # What this host allows Kastellan (and for which containers): read-only, for the app.
    print(" ".join(installed))
    for ability in installed:
        try:
            pattern = FORMS[ability]
            with open(f"/etc/kastellan/act/{ability}.allow") as f:
                allowed = [ln.strip() for ln in f if pattern and (pattern.fullmatch(ln.strip()) or ln.strip() == "*")]
            print(f"{ability}: {' '.join(allowed)}")
        except OSError:
            pass
    # Which scripts these are, so the hub can tell older ones (a hash of each file).
    hashes = []
    for name in ["dispatch", *installed]:
        try:
            with open(os.path.join(BASE, name), "rb") as f:
                hashes.append(f"{name}={hashlib.sha256(f.read()).hexdigest()[:16]}")
        except OSError:
            pass
    print("versions: " + " ".join(hashes))
    sys.exit(0)

if not words or words[0] not in FORMS:
    print("unknown action; this host allows: " + (" ".join(installed) or "nothing"), file=sys.stderr)
    sys.exit(2)
ability, args = words[0], words[1:]
if ability not in installed:
    print(f"{ability} isn't installed on this host", file=sys.stderr)
    sys.exit(3)
pattern = FORMS[ability]
# update-container may name the tag to go to: another tag of the same image (`<name> <tag>`).
if ability == "update-container" and len(args) == 2 and TAG.fullmatch(args[1]):
    args_checked = args[:1]
else:
    args_checked = args
if (pattern is None and args) or (
    pattern is not None and (len(args_checked) != 1 or not pattern.fullmatch(args_checked[0]))
):
    print(f"{ability}: wrong arguments", file=sys.stderr)
    sys.exit(2)

# The same python3 that runs this (the one the sudo rules name), and sudo by its full path.
sudo = next(p for p in ("/usr/bin/sudo", "/bin/sudo", "/usr/local/bin/sudo") if os.path.exists(p))
os.execv(sudo, ["sudo", "-n", sys.executable, "-I", "-S", os.path.join(BASE, ability), *args])
